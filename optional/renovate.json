{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "//": "Alternative to .github/dependabot.yml. Move it to the repository root and delete dependabot.yml; running both produces duplicate pull requests. Renovate needs its GitHub App installed, which Dependabot does not, but it is the only one of the two that can keep versions.env in sync.",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "addLabels": ["component/ci"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "groupName": "go minor and patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool pins in versions.env, annotated with a renovate comment",
      "managerFilePatterns": ["/(^|/)versions\\.env$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?)\\s+depName=(?<depName>[^\\s]+?)(?:\\s+versioning=(?<versioning>[^\\s]+?))?\\s*\\n[A-Z0-9_]+=v?(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
