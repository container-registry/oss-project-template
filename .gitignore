# Build output. `task build` writes to bin/. A bare `go build ./...` instead
# drops a binary named after the directory into the repository root; that one
# cannot be listed here by name in a template, so repo-lint fails on any
# committed executable rather than trying to guess the name.
bin/
dist/
*.exe

# Workflow script dependencies, installed by `npm ci` in CI only.
node_modules/

# Test and lint output
coverage.out
coverage.txt
licenses.csv

# Local tool and editor state
.task/
.idea/
.vscode/
temp/

# Claude Code: shared configuration is committed, local state is not.
.claude/settings.local.json
.claude/plans/
.claude/.cc-writes/

# Never commit these.
.env
*.pem
*.key
