# Shared tool version pins - single source of truth.
#
# Loaded by Taskfile.yml via `dotenv:` and read by the CI workflows, so a local
# run and a CI run use the same tool versions. Renovate updates the entries
# through the custom regex managers in optional/renovate.json.
#
# Tools downloaded as release archives also pin a sha256. Regenerate a checksum
# when bumping the version:
#   curl -sfLO <release asset url> && shasum -a 256 <file>
#
# Dependabot has no manager for env files, so these pins are updated by hand
# unless the project adopts Renovate (optional/renovate.json), whose custom
# manager reads the `# renovate:` annotations below. Renovate can run beside
# Dependabot when it is limited to this file; the config explains how.
#
# Renovate bumps the version line only. The stale sha256 then fails where the
# tool is installed, until the *_SHA256_* lines are regenerated in that pull
# request: typos and actionlint in the hygiene workflow, Task in
# .github/actions/setup. That failure is deliberate: it is the only reminder
# that a hand-verified pin changed.

# Task runner installed by CI (local installs may differ).
# renovate: datasource=github-releases depName=go-task/task
TASK_VERSION=3.49.1
# Committed here rather than read from the release's own task_checksums.txt:
# a checksum fetched from the artifact's own release only proves the release is
# internally consistent, not that it is the release we reviewed.
TASK_SHA256_LINUX_AMD64=4e7d24f1bf38218aec8f244eb7ba671f898830f9f87b3c9b30ff1c09e3135576
TASK_SHA256_LINUX_ARM64=aa6732c9c66397c5380ec2b60c070fd599075b2a8538dba03f3a21edc99ab0cb
TASK_SHA256_DARWIN_AMD64=8bc4dd3baed1c71956ade0bb0a9c1b94e3ed7b65e7f2ff3aab13d0562c820e59
TASK_SHA256_DARWIN_ARM64=0f556b66df69d53b790c7fd26bfab73543b4a5ce1767df6b2e8499619e2a205b

# Spell checker. crate-ci publishes no checksum file, so this is our own pin of
# the x86_64-unknown-linux-musl asset, matched to the runner the hygiene job uses.
# renovate: datasource=github-releases depName=crate-ci/typos
TYPOS_VERSION=1.44.0
TYPOS_SHA256_LINUX_X86_64=1b788b7d764e2f20fe089487428a3944ed218d1fb6fcd8eac4230b5893a38779

# GitHub Actions workflow linter. Upstream publishes checksums with each release.
# renovate: datasource=github-releases depName=rhysd/actionlint
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256_LINUX_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ACTIONLINT_SHA256_LINUX_ARM64=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
ACTIONLINT_SHA256_DARWIN_ARM64=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f

# Workflow security auditor. The action defaults to `latest`, which means a
# new rule release can turn main red overnight without a commit.
# renovate: datasource=github-releases depName=zizmorcore/zizmor
ZIZMOR_VERSION=1.29.0

# YAML linter, installed with pip.
# renovate: datasource=pypi depName=yamllint
YAMLLINT_VERSION=1.35.1

# Base image for the container. Pinned by digest, not by tag: `nonroot` is a
# moving tag, and a digest is the only thing that makes the build reproducible.
# The Dockerfile ARG defaults must match these two values.
# renovate: datasource=docker depName=gcr.io/distroless/static-debian12
BASE_IMAGE=gcr.io/distroless/static-debian12:nonroot
BASE_IMAGE_DIGEST=sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

# --- Go pack -------------------------------------------------------------
# Delete this block along with the Go pack if the project is not Go.
# The Go toolchain itself is not pinned here; it comes from go.mod.

# renovate: datasource=github-releases depName=golangci/golangci-lint
GOLANGCILINT_VERSION=v2.8.0
# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.4.0
# renovate: datasource=github-releases depName=google/go-licenses
GOLICENSES_VERSION=v2.0.1

# --- Helm pack -----------------------------------------------------------
# Delete this block along with the Helm chart pack (deploy/chart, taskfile/helm.yml).
# chart-ci.yml installs these on linux/amd64 and verifies the archives against
# the sha256 pins below; the Taskfile falls back to the same versions as images.

# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.2.4
# renovate: datasource=github-releases depName=helm-unittest/helm-unittest
HELM_UNITTEST_VERSION=v1.1.2

# https://github.com/norwoodj/helm-docs/releases/download/v${HELM_DOCS_VERSION}/helm-docs_${HELM_DOCS_VERSION}_Linux_x86_64.tar.gz
# renovate: datasource=github-releases depName=norwoodj/helm-docs extractVersion=^v(?<version>.+)$
HELM_DOCS_VERSION=1.14.2
HELM_DOCS_SHA256_LINUX_AMD64=a8cf72ada34fad93285ba2a452b38bdc5bd52cc9a571236244ec31022928d6cc

# https://github.com/helm/chart-testing/releases/download/v${CT_VERSION}/chart-testing_${CT_VERSION}_linux_amd64.tar.gz
# renovate: datasource=github-releases depName=helm/chart-testing extractVersion=^v(?<version>.+)$
CT_VERSION=3.14.0
CT_SHA256_LINUX_AMD64=d16f0583616885423826241164ce1f6589c6fe5332fa74f374ebd2bd3cb3fe1f

# https://github.com/stackrox/kube-linter/releases/download/v${KUBE_LINTER_VERSION}/kube-linter-linux.tar.gz
# (the amd64 asset carries no arch suffix; upstream publishes no checksum file)
# renovate: datasource=github-releases depName=stackrox/kube-linter extractVersion=^v(?<version>.+)$
KUBE_LINTER_VERSION=0.8.3
KUBE_LINTER_SHA256_LINUX_AMD64=1a6d8419b11971372971fdbc22682b684ebfb7cf1c39591662d1b6ca736c41df

# https://github.com/artifacthub/hub/releases/download/v${AH_VERSION}/ah_${AH_VERSION}_linux_amd64.tar.gz
# renovate: datasource=github-releases depName=artifacthub/hub extractVersion=^v(?<version>.+)$
AH_VERSION=1.23.0
AH_SHA256_LINUX_AMD64=062dbd849d8d6de688627baca9042b3dd2ce4cf6c9767fba1d4d0b4e8476c18c

# https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz
# Used for `trivy config` over the rendered chart, nothing else.
# renovate: datasource=github-releases depName=aquasecurity/trivy extractVersion=^v(?<version>.+)$
TRIVY_VERSION=0.74.0
TRIVY_SHA256_LINUX_AMD64=2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a

# renovate: datasource=github-releases depName=oras-project/oras extractVersion=^v(?<version>.+)$
ORAS_VERSION=1.3.4
# renovate: datasource=npm depName=ajv-cli
AJV_CLI_VERSION=5.0.0
# Node major for ajv-cli via npx (actions/setup-node in CI, node:<major>-alpine locally)
# renovate: datasource=node-version depName=node
NODE_VERSION=24
# chart-testing's lint step shells out to yamale and yamllint; pinned like
# everything else here, or the chart gate resolves whatever PyPI serves.
# renovate: datasource=pypi depName=yamale
YAMALE_VERSION=6.1.0
# renovate: datasource=pypi depName=pyyaml
PYYAML_VERSION=6.0.3
