{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-header": "Release. Merging this pull request tags `vX.Y.Z` and creates the GitHub release.",
  "pull-request-footer": "Squash-merge to release. `docs/RELEASES.md` explains the version rules and what the merge triggers.",
  "pull-request-title-pattern": "chore: release ${version}",
  "release-type": "simple",
  "always-update": true,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "exclude-paths": [
    "docs",
    ".github"
  ],
  "packages": {
    ".": {}
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI/CD",
      "hidden": true
    }
  ]
}
